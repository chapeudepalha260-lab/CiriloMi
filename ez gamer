-- FUNÇÕES
local function getChar() return plr.Character or plr.CharacterAdded:Wait() end

local function irAte(pos)
	local hrp = getChar():WaitForChild("HumanoidRootPart")
	local dist = (hrp.Position - pos).Magnitude
	local tempo = dist / 60
	TweenService:Create(hrp, TweenInfo.new(tempo), {CFrame = CFrame.new(pos)}):Play()
end

local function getListaNPC()
	local lista = {}
	local pasta = workspace:FindFirstChild(NOME_PASTA_NPC)
	if pasta then
		for _, npc in pairs(pasta:GetChildren()) do
			if npc:FindFirstChild("Humanoid") then table.insert(lista, npc.Name) end
		end
	end
	return lista
end

local function getNPC(nome)
	local pasta = workspace:FindFirstChild(NOME_PASTA_NPC)
	if pasta then return pasta:FindFirstChild(nome) end
end

local function equiparArma()
	local char = getChar()
	if AUTO_HAKI then -- "Haki" = só pra dar dano
		-- Aqui você adicionaria o efeito da sua arma
	end
	if not char:FindFirstChild(NOME_DA_ARMA) then
		local tool = plr.Backpack:FindFirstChild(NOME_DA_ARMA)
		if tool then char.Humanoid:EquipTool(tool) end
	end
end

-- CRIAR BOTOES
local function criarBotao(texto, posY, func)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0.9, 0, 0, 35)
	btn.Position = UDim2.new(0.05, 0, 0, posY)
	btn.Text = texto
	btn.TextColor3 = Color3.white
	btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	btn.Font = Enum.Font.GothamSemibold
	btn.TextSize = 15
	btn.Parent = frame
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
	btn.MouseButton1Click:Connect(func)
	return btn
end

