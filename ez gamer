				irAte(npc.HumanoidRootPart.Position + Vector3.new(0,0,3))
				while npc.Humanoid.Health > 0 and AUTO_FARM do
					VirtualInput:SendMouseButtonEvent(0,0,0,true,game,1)
					task.wait(0.1)
				end
			end
		end
	end
end)
